rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             (!('monthlyLimit' in data) || (data.monthlyLimit is number && data.monthlyLimit >= 0)) &&
             (!('currency' in data) || (data.currency is string && data.currency.size() <= 10)) &&
             (!('language' in data) || (data.language is string && data.language.size() <= 10)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidExpense(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.amount is number && data.amount > 0 && data.amount <= 1000000000 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 64 &&
             data.categoryName is string && data.categoryName.size() > 0 && data.categoryName.size() <= 100 &&
             data.expenseDate is string && data.expenseDate.size() >= 8 && data.expenseDate.size() <= 20 &&
             data.paymentMethod is string && data.paymentMethod.size() > 0 && data.paymentMethod.size() <= 50 &&
             (!('expenseTime' in data) || (data.expenseTime is string && data.expenseTime.size() <= 20)) &&
             (!('shopName' in data) || (data.shopName is string && data.shopName.size() <= 150)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 20 && (data.tags.size() == 0 || data.tags[0] is string))) &&
             (!('isSplit' in data) || data.isSplit is bool) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming());

      allow delete: if isSignedIn() && request.auth.uid == userId;

      match /expenses/{expenseId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'amount', 'title', 'categoryId', 'categoryName', 'expenseDate', 'paymentMethod', 'createdAt']) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidExpense(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidExpense(incoming());

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
